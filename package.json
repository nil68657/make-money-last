{
  "name": "make-money-last",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev",
    "dev:bg": "node scripts/dev-server.mjs start",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:status": "node scripts/dev-server.mjs status",
    "dev:restart": "node scripts/dev-server.mjs stop && node scripts/dev-server.mjs start",
    "health": "node scripts/health-check.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "verify": "node scripts/verify-app.mjs",
    "verify:model": "tsc scripts/verify-model.ts --outDir .verify-out --module commonjs --target es2019 --moduleResolution node --esModuleInterop --skipLibCheck --lib es2019,dom && node .verify-out/scripts/verify-model.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.469.0",
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.21",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
